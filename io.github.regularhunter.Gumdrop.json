{
    "app-id" : "io.github.regularhunter.Gumdrop",
    "runtime" : "org.gnome.Platform",
    "runtime-version" : "51",
    "sdk" : "org.gnome.Sdk",
    "sdk-extensions" : [
        "org.freedesktop.Sdk.Extension.rust-stable"
    ],
    "command" : "gumdrop",
    "finish-args" : [
        "--share=ipc",
        "--socket=fallback-x11",
        "--device=dri",
        "--socket=wayland",
        "--socket=pulseaudio",
        "--filesystem=xdg-music:ro"
    ],
    "build-options" : {
        "append-path" : "/usr/lib/sdk/rust-stable/bin",
        "env" : {
            "G_MESSAGES_DEBUG" : "none",
            "RUST_BACKTRACE" : "1",
            "RUST_LOG" : "gumdrop=debug,glib=debug",
            "CARGO_NET_OFFLINE": "true"
        }
    },
    "modules" : [
        {
            "name" : "gumdrop",
            "builddir" : true,
            "buildsystem" : "meson",
            "config-opts" : [
                "-Dprofile=default",
                "--libdir=lib"
            ],
            "sources" : [
                {
                    "type" : "git",
                    "url" : "https://github.com/regularhunter/gumdrop.git",
                    "commit" : "69df27f190b1de132f9850339a4b3cb25523a9e6"
                },
                "cargo-sources.json"
            ]
        }
    ]
}
