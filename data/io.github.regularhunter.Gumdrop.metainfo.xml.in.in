<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>@APPLICATION_ID@</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <name>Gumdrop</name>
  <summary>Plays music.</summary>
  <description>
    <p>
      Gumdrop is a fast and simple music player. It is intended for users that
      want to listen to large, local music libraries.
    </p>
    <p>Current features:</p>
    <ul>
      <li>Persistent library organization</li>
      <li>Adaptive UI</li>
      <li>UI recoloring using the album art</li>
      <li>Drag and drop support to queue songs</li>
      <li>Shuffle and repeat</li>
      <li>MPRIS integration</li>
    </ul>
  </description>
  <branding>
    <color type="primary" scheme_preference="light">#90c0ff</color>
    <color type="primary" scheme_preference="dark">#003681</color>
  </branding>
  <launchable type="desktop-id">@APPLICATION_ID@.desktop</launchable>
  <url type="homepage">https://github.com/regularhunter/gumdrop</url>
  <url type="bugtracker">https://github.com/regularhunter/gumdrop/issues</url>
  <url type="donation">https://ko-fi.com/rhunter</url>
  <developer_name>Hunter Wardlaw</developer_name>
  <developer id="io.github.regularhunter">
    <name>Hunter Wardlaw</name>
  </developer>
  <translation type="gettext">gumdrop</translation>
  <custom>
    <value key="Purism::form_factor">mobile</value>
  </custom>
  <requires>
    <display_length compare="ge">360</display_length>
  </requires>
  <recommends>
    <control>keyboard</control>
    <control>pointing</control>
    <control>touch</control>
  </recommends>
  <releases>
    <release version="0.2.0" date="2026-11-06">
      <description>
        <ul>
          <li>Add rescan library shortcut (Ctrl+R)</li>
          <li>Find new tracks during rescan, not just removed tracks</li>
          <li>Optimize library scan by only computing album artists once</li>
          <li>Combine 'Various Artists' entries in library</li>
          <li>Sort 'Various Artists' and 'Unknown Artists' alphabetically</li>
          <li>Share cover art cache between sidebar views (artists, albums, queue)</li>
          <li>Display audio format information (File format, Bit-depth, Sample rate)</li>
          <li>Display larger cover art</li>
          <li>Add MPRIS volume control support</li>
          <li>Replace deprecated dark-style.css with media queries</li>
        </ul>
      </description>
    </release>
    <release version="0.1.2" date="2026-11-02">
      <description>
        <ul>
          <li>First public release!</li>
          <li>Implement sqlite database backend for persistent music libraries</li>
          <li>Add UI elements to browse new persistent library database</li>
          <li>Forked from Amberol.</li>
        </ul>
      </description>
    </release>
    <release version="0.1.1" type="development" date="2025-02-27"/>
    <release version="0.1.0" type="development" date="2025-02-27"/>
  </releases>
  <kudos>
    <kudo>ModernToolkit</kudo>
    <kudo>Notifications</kudo>
  </kudos>
  <content_rating type="oars-1.1"/>
  <provides>@APPLICATION_ID@.desktop</provides>
</component>
